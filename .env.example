# ──────────────────────────────────────────────────────────────────────────────
# Frontend (Vite - VITE_ prefix exposes to client bundle)
# ──────────────────────────────────────────────────────────────────────────────

# API base URL for client-side requests (public, embedded in JS bundle)
VITE_API_URL=""

# Google Analytics Measurement ID (public, SEO/analytics tracking)
VITE_GA_MEASUREMENT_ID=""

# ──────────────────────────────────────────────────────────────────────────────
# Server (NOT exposed to client)
# ──────────────────────────────────────────────────────────────────────────────

# Runtime environment: "development" | "production"
NODE_ENV=""

# Admin password for /admin/login endpoint (keep secret!)
ADMIN_PASSWORD=""

# HMAC key used to sign admin session cookies (minimum 32 random characters)
# Generate example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Comma-separated browser origins allowed to call mutation APIs
# Production example: https://devfiro.com,https://www.devfiro.com
CORS_ORIGIN=""

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# SQLite URLs such as file:./dev.db are not supported.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ──────────────────────────────────────────────────────────────────────────────
# AWS S3 / R2 (Image storage)
# ──────────────────────────────────────────────────────────────────────────────

# S3-compatible endpoint (e.g., Cloudflare R2)
S3_ENDPOINT=""

# Access credentials for S3/R2 bucket
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Bucket name
S3_BUCKET_NAME=""

# Public URL prefix for serving stored images
S3_PUBLIC_URL=""
